# ===== 循迹（Trace）团队版配置（安装脚本会生成 .env 并填好关键项）=====

# 运行模式：lite（单进程：API + 执行器一体，团队版仍用这个形态）
GA_MODE=lite

# 数据目录：MySQL 数据、聊天附图、项目工作区、日志都在它下面。
# 升级/换版本时只替换程序文件，绝不删除或重建这个目录。
# 换位置优先用界面「设置 → 存储空间 → 迁移」：会自动停内置 MariaDB、整体搬迁、
# 改写本项并在重启后清理旧目录。只有启动脚本/systemd 里 export 的 GA_DATA_DIR
# 才算「锁死」，那种情况下界面迁移会直接拒绝并提示先去掉它。
GA_DATA_DIR=

# 主密钥：登录令牌签名用；安装脚本会自动生成，换机器迁移数据时请保持一致
GA_SECRET_KEY=

# 数据库：团队版用 MySQL/MariaDB。Linux 包内置 MariaDB，安装脚本会自动生成这一项，
# 形如 mysql+aiomysql://trace:密码@127.0.0.1:33306/trace?charset=utf8mb4
# 本机源码调试若想用 SQLite，可写 sqlite+aiosqlite:///<绝对路径>。
DATABASE_URL=

# 项目工作区根目录（所有项目仓库所在）。默认 <DATA_DIR>/projects
PROJECTS_ROOT=

# 大模型：模型/地址/Key 只能由管理员在界面里配置——「设置 → 模型配置」添加供应商，
# 「设置 → 智能体」把工作区绑到档位（作用范围选团队默认或某个项目）。团队版**没有** .env 全局兜底：
# 没绑定时对话会直接失败并提示去绑定（不会再悄悄读下面的环境变量）。
# 旧 .env 里残留的 OPENAI_API_KEY / OPENAI_BASE_URL / GA_LLM_MODEL 已不再生效，可删。
# 单次 LLM 调用硬上限（秒），防网关挂起卡死 run
# GA_LLM_CALL_TIMEOUT_S=360
# 建连超时（秒）：跨境端点偶发 A 记录黑洞，8s 足够
# GA_LLM_CONNECT_TIMEOUT_S=8
# 进程级 LLM 并发上限：收到 429 会自动腰斩并发，0 = 不限（仅排查用）
# GA_LLM_MAX_CONCURRENCY=12
# 子agent 推理强度：none|low|medium|high|空=不干预
# GA_SUB_REASONING_EFFORT=none
# 同 run 内「同工具 + 同参数」的只读调用复用上次结果
# GA_TOOL_MEMO=true
# 是否显式声明 parallel_tool_calls（端点不认会自动去掉重发）
# GA_LLM_PARALLEL_TOOL_CALLS=true

# 服务监听：团队版部署在一台机器上供同事访问时用 0.0.0.0；
# 只允许本机访问则改回 127.0.0.1。
GA_HOST=0.0.0.0
# 端口默认 18888，被占用时服务会自动顺延并打印实际端口
GA_PORT=18888

# 首启是否把 examples/cardgame 拷成示例项目（团队版默认关闭：只建管理员账号）
# GA_SEED_DEMO=0

# 服务就绪后是否自动打开浏览器（服务器上通常没有浏览器，保持 0）
# GA_OPEN_BROWSER=0

# ---------- 运行约束 ----------
# 并行执行的 run 数（进程内 worker 数）；真正瓶颈是 CPU/内存与外部端点配额
GA_MAX_CONCURRENT_RUNS=64
# 同项目允许多条 run 并行改工作区；false = 同项目串行（写锁）
GA_SAME_PROJECT_PARALLEL=true
# 单条 shell 命令的等待上限（秒）
GA_TOOL_TIMEOUT_S=300
# 单次工具调用的总超时兜底（秒），设 0 关闭
GA_TOOL_HARD_TIMEOUT_S=900
# 同一轮最多执行多少个工具调用（超出部分提示模型分批）
GA_MAX_TOOL_CALLS_PER_ROUND=12
# 递归扫描类命令的单独上限（秒），设为 0 无效（最小 10）
GA_SEARCH_TIMEOUT_S=60
# 单个子agent 的挂钟上限（秒），超时只掐这一条子任务
GA_SUBAGENT_TIMEOUT_S=600

# ---------- AI 联网搜索（web_search / web_fetch 工具） ----------
# bing = 无 key 抓取必应结果页（默认）；ddg = DuckDuckGo HTML 版；tavily = 需要 key
GA_SEARCH_PROVIDER=bing
# GA_TAVILY_KEY=tvly-xxxx
GA_WEB_SEARCH_TIMEOUT_S=15
